{
  "manifest_version": 3,
  "name": "Lumen Gallery",
  "short_name": "Lumen",
  "description": "Private, offline viewer for folders of images, GIFs and videos. Reopen recent folders and resume where you left off.",
  "author": "Abdul Hadi Khan",
  "version": "2.0.0",
  "homepage_url": "https://abduldevhub.github.io/Lumen-Gallery/",
  "offline_enabled": true,
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Lumen Gallery (Alt+G)",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+G"
      }
    }
  }
}
