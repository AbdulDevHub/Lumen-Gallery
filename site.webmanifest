{
  "name": "Lumen Gallery",
  "short_name": "Lumen",
  "description": "Private, offline viewer for folders of images, GIFs and videos.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#141311",
  "theme_color": "#141311",
  "categories": ["photo", "productivity", "utilities"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "screenshots": [
    { "src": "assets/og-image.png", "sizes": "1200x630", "type": "image/png", "form_factor": "wide", "label": "A folder open in Lumen Gallery" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "image/*": [".jpg", ".jpeg", ".png", ".gif", ".webp", ".avif", ".bmp"],
        "video/*": [".mp4", ".webm", ".mov"]
      }
    }
  ],
  "launch_handler": { "client_mode": "focus-existing" }
}
